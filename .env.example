# Brevo (https://www.brevo.com) – Contact form mailer
# Create an API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Sender shown in emails (must be a verified sender in Brevo)
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Portfolio Contact

# Where to receive contact form submissions (defaults to truongnguyen1582000@gmail.com if unset)
BREVO_CONTACT_RECIPIENT=truongnguyen1582000@gmail.com

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=
